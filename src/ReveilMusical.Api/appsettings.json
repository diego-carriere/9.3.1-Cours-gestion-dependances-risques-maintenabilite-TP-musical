{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Wakeup": {
    "FallbackChannels": [ "push", "sms", "email" ]
  },

  "Music": {
    "Providers": [ "itunes", "musicbrainz" ],
    "ITunes": {
      "BaseUrl": "https://itunes.apple.com/",
      "Country": "FR",
      "Limit": 5,
      "RequestsPerMinute": 20
    },
    "MusicBrainz": {
      "BaseUrl": "https://musicbrainz.org/",
      "UserAgent": "ReveilMusical/1.0 ( https://github.com/diego-carriere/9.3.1-Cours-gestion-dependances-risques-maintenabilite-TP-musical )",
      "Limit": 5,
      "RequestsPerSecond": 1
    },
    "Cache": {
      "Freshness": "1.00:00:00",
      "StaleRetention": "7.00:00:00"
    }
  },

  "Resilience": {
    "Music": {
      "ITunes": { "TotalTimeout": "00:00:08", "AttemptTimeout": "00:00:03", "RetryCount": 1 },
      "MusicBrainz": { "TotalTimeout": "00:00:08", "AttemptTimeout": "00:00:03", "RetryCount": 1 }
    },
    "Channels": { "AttemptTimeout": "00:00:03", "RetryCount": 1 }
  },

  "Vendors": {
    "Mail": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false, "FromAddress": "reveil@example.com" },
    "Sms": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false, "SenderName": "REVEIL" },
    "Push": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false }
  },

