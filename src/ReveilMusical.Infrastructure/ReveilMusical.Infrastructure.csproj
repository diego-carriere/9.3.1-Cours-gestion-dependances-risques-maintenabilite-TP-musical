<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pas de référence à ReveilMusical.Application : l'Infrastructure implémente les ports du
       Domaine sans rien connaître du cas d'usage qui les consomme. -->
  <ItemGroup>
    <ProjectReference Include="..\ReveilMusical.Domain\ReveilMusical.Domain.csproj" />
    <ProjectReference Include="..\ReveilMusical.FakeVendors\ReveilMusical.FakeVendors.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Référencés directement (et pas seulement en transitif via Http.Resilience) : le code
         appelle leur API. Pipelines non HTTP des canaux de notification : -->
    <PackageReference Include="Polly.Extensions" />
    <!-- Idem : les limiteurs de débit iTunes/MusicBrainz et leur exception de rejet. -->
    <PackageReference Include="Polly.RateLimiting" />
  </ItemGroup>

</Project>
