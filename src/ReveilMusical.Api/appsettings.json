{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Wakeup": {
    "MaxSearchAttempts": 3,
    "FallbackChannels": [ "push", "sms", "email" ]
  },

  "Music": {
    "Providers": [ "itunes", "musicbrainz" ],
    "ITunes": {
      "BaseUrl": "https://itunes.apple.com/",
      "Country": "FR",
      "Limit": 5,
      "RequestsPerMinute": 20
    },
    "MusicBrainz": {
      "BaseUrl": "https://musicbrainz.org/",
      "UserAgent": "ReveilMusical/1.0 ( https://github.com/diego-carriere/9.3.1-Cours-gestion-dependances-risques-maintenabilite-TP-musical )",
      "Limit": 5,
      "RequestsPerSecond": 1
    },
    "Cache": {
      "Freshness": "1.00:00:00",
      "StaleRetention": "7.00:00:00"
    }
  },

  "Resilience": {
    "Music": {
      "ITunes": { "TotalTimeout": "00:00:08", "AttemptTimeout": "00:00:03", "RetryCount": 1 },
      "MusicBrainz": { "TotalTimeout": "00:00:08", "AttemptTimeout": "00:00:03", "RetryCount": 1 }
    },
    "Channels": { "AttemptTimeout": "00:00:03", "RetryCount": 1 }
  },

  "Vendors": {
    "Mail": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false, "FromAddress": "reveil@example.com" },
    "Sms": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false, "SenderName": "REVEIL" },
    "Push": { "OutboxDirectory": "outbox", "WriteToConsole": true, "SimulateOutage": false }
  },

  "UserService": {
    "SimulateOutage": false,
    "Users": [
      {
        "Id": "42",
        "DisplayName": "Alice",
        "PreferredChannel": "push",
        "Contacts": { "push": "device-token-alice-0001", "sms": "+33612345678", "email": "alice@example.com" },
        "KeywordsByWeather": {
          "SOLEIL": [ "soleil", "beau temps", "sunshine" ],
          "PLUIE": [ "pluie", "rain", "storm" ],
          "NEIGE": [ "neige", "snow" ]
        },
        "KeywordsByDayAndWeather": { "LUNDI+PLUIE": [ "monday", "blues" ] },
        "FallbackKeywords": [ "wake up", "morning" ]
      },
      {
        "Id": "7",
        "DisplayName": "Bruno",
        "PreferredChannel": "sms",
        "Contacts": { "sms": "+33698765432", "email": "bruno@example.com" },
        "KeywordsByWeather": { "NUAGEUX": [ "nuages", "cloudy" ] },
        "KeywordsByDayAndWeather": { "VENDREDI+SOLEIL": [ "weekend", "friday" ] },
        "FallbackKeywords": [ "good morning" ]
      },
      {
        "Id": "13",
        "DisplayName": "Chloé",
        "PreferredChannel": "email",
        "Contacts": { "email": "chloe@example.com" },
        "KeywordsByWeather": { "SOLEIL": [ "summer" ], "NEIGE": [ "hiver" ] },
        "FallbackKeywords": [ "réveil" ]
      }
    ]
  }
}
